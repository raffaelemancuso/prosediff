<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.repo_name }}: {{ c.base.short }}..{{ c.target.short }}</title>
<style>
:root {
  --bg: #ffffff; --fg: #1f2328; --muted: #656d76; --border: #d0d7de;
  --panel: #f6f8fa; --del-line: #ffebe9; --del-word: #ff818266;
  --ins-line: #e6ffec; --ins-word: #4ac26b66; --skip: #ddf4ff;
  --add: #1a7f37; --rem: #cf222e; --link: #0969da;
  --move-line: #fbefff; --move: #8250df; --current: #bf8700;
  --fmt: #9a6700; --fmt-bg: #fff8c5; --flash: #ffd33d99;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --fg: #e6edf3; --muted: #8d96a0; --border: #30363d;
    --panel: #161b22; --del-line: #f851491a; --del-word: #f8514966;
    --ins-line: #2ea04326; --ins-word: #2ea04366; --skip: #388bfd1a;
    --add: #3fb950; --rem: #f85149; --link: #4493f8;
    --move-line: #ab7df826; --move: #ab7df8; --current: #d29922;
    --fmt: #d29922; --fmt-bg: #bb800933; --flash: #e3b34166;
  }
}
/* On paper, the light colours even when the browser is in dark mode: no
   page printed dark. */
@media print {
  :root {
    --bg: #ffffff; --fg: #1f2328; --muted: #656d76; --border: #d0d7de;
    --panel: #f6f8fa; --del-line: #ffebe9; --del-word: #ff818266;
    --ins-line: #e6ffec; --ins-word: #4ac26b66; --skip: #ddf4ff;
    --add: #1a7f37; --rem: #cf222e; --link: #0969da;
    --move-line: #fbefff; --move: #8250df; --current: #bf8700;
    --fmt: #9a6700; --fmt-bg: #fff8c5; --flash: #ffd33d99;
  }
}
* { box-sizing: border-box; }
/* The page takes the whole width: the two versions side by side, and the
   margin of comments and problems beside them. --bar-h: the top bar's
   height, set by the script, for what sticks under it. */
:root { --bar-h: 49px; --notes-w: 340px; --review-w: 320px; }
body { margin: 0; padding: 0 16px 24px; background: var(--bg); color: var(--fg);
  font: 14px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; }
main { margin: 0; padding-top: 16px; }
h1 { font-size: 20px; margin: 0 0 6px; }
h1 .full-path { font-size: 12px; font-weight: 400; margin-left: 8px; }
h2 { font-size: 15px; margin: 0 0 6px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap; }
:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
/* The header: the title, then a line for each side, its path (outside
   git) on the same line. */
.revisions { display: grid; grid-template-columns: auto auto auto 1fr; gap: 2px 12px;
  align-items: baseline; margin-bottom: 12px; }
.role { color: var(--muted); }
.revisions code { font-weight: 600; }
.full-path { font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted);
  overflow-wrap: anywhere; }
@media (max-width: 800px) {
  .revisions { grid-template-columns: auto auto 1fr; }
  .revisions .full-path { grid-column: 2 / 4; }
}
.commits { margin-bottom: 12px; }
.commits summary { cursor: pointer; color: var(--muted); }
.commits ol { margin: 6px 0 0; padding-left: 0; list-style: none; }
.commits li { display: grid; grid-template-columns: 5.5em 9em 1fr; gap: 8px; }
.commits li code { color: var(--muted); }
/* A mark clicked (a comment's marker, a problem's badge, or its card in the
   margin) pinned: its text highlighted (a highlight of the script's
   ranges), or its paragraph when where that text ends is not known, the
   mark ringed and its card too, until clicked again. */
::highlight(pin) { background-color: var(--flash); }
td.code.pinned { background-color: var(--flash) !important; }
.comment.pinned, .ai-mark.pinned { box-shadow: 0 0 0 3px var(--current); border-radius: 3px; }
td.code .comment, td.code .ai-mark { cursor: pointer; }
/* The margin: a card for each comment and each problem the AI marked,
   beside the row it is in, in the order they come in its text. */
col.notes { width: var(--notes-w); }
td.notes { position: relative; border-left: 1px solid var(--border); padding: 0;
  font: 13px/1.45 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  white-space: normal; text-align: left; }
/* A row's cards start beside it and run on down the margin, over the rows
   below, when they are taller than it: the rows keep the height of their
   text. The script places them, a stack pushed down when the one above
   reaches it. Under their row instead where there is no margin (a narrow
   window, one column, paper). */
.stack { position: absolute; left: 8px; right: 8px; top: 4px; z-index: 1; }
.card { display: block; margin: 0 0 8px; padding: 7px 10px; border: 1px solid var(--border);
  border-radius: 8px; background: var(--bg); color: var(--fg); cursor: pointer; }
.card:last-child { margin-bottom: 0; }
.card.problem { border-color: color-mix(in srgb, var(--current) 45%, var(--border)); }
.card.active { border-color: var(--current); box-shadow: 0 0 0 2px var(--current); }
.card .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
.card .go { font: inherit; color: inherit; background: none; border: 0; padding: 0;
  cursor: pointer; text-align: left; display: inline-flex; flex-wrap: wrap; gap: 2px 8px;
  align-items: baseline; }
.card .chip { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 999px;
  color: var(--muted); background: var(--panel); white-space: nowrap; }
.card.comment-new .chip { color: var(--add); background: var(--ins-line); }
.card.comment-removed .chip { color: var(--rem); background: var(--del-line); }
.card.problem .chip { color: var(--fmt); background: var(--fmt-bg); }
.card .who { font-weight: 600; }
.card .when { color: var(--muted); font-size: 12px; }
.card .body { margin-top: 3px; overflow-wrap: anywhere; }
.card .body.clamped { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical;
  overflow: hidden; }
.card .line { display: block; }
.card .line:empty { height: 0.7em; }
.card .solution b { font-weight: 600; }
.card .more { font: inherit; font-size: 12px; color: var(--link); background: none; border: 0;
  padding: 2px 0 0; cursor: pointer; }
/* The handles that resize the columns: on the line between the old and the
   new version, and on the margin's edge; a line in the link colour on
   hover and while dragged. Not where there are no columns side by side. */
.col-resizer { position: absolute; width: 11px; margin-left: -5px; z-index: 2;
  cursor: col-resize; touch-action: none; }
.col-resizer:hover, .col-resizer.dragging {
  background: linear-gradient(var(--link), var(--link)) center / 2px 100% no-repeat; }
body.col-dragging { cursor: col-resize; user-select: none; }
body.unified .col-resizer, body.review .col-resizer { display: none; }
@media screen and (max-width: 1100px) { .col-resizer { display: none; } }
@media print { .col-resizer { display: none; } }
/* No comment and no problem anywhere, or the margin hidden by its switch
   (g): no margin, the two versions taking its width. */
body.no-notes col.notes, body:not(.margin) col.notes { width: 0 !important; }
body.no-notes td.notes, body:not(.margin) td.notes,
body:not(.margin) .col-resizer[data-resize="notes"] { display: none; }
.toolbar .margin-button { padding: 3px 10px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg); }
.toolbar .margin-button[aria-pressed="false"] { color: var(--muted); }
/* The one style of the buttons in the page: link-coloured text, a tint on
   hover, and, pressed, a tinted box ringed in the link colour, as the
   toolbar's switches. */
.btn { font: inherit; color: var(--link); background: none; border: 0; cursor: pointer;
  padding: 1px 6px; border-radius: 5px; }
.btn:hover { background: var(--skip); }
.btn[aria-pressed="true"] { background: var(--skip); color: var(--fg);
  box-shadow: inset 0 0 0 1px var(--link); }
/* The AI's assessment: a drawer over the right of the page, opened from
   its verdict in the top bar, the text going on scrolling under it; on
   paper, a box at the top. Its verdict is a coloured badge. */
.drawer { position: fixed; top: var(--bar-h); right: 0; bottom: 0; z-index: 3;
  width: min(600px, 92vw); overflow: auto; padding: 12px 20px 24px; background: var(--bg);
  border-left: 1px solid var(--border); box-shadow: -4px 0 16px #0002; }
.drawer[hidden] { display: none; }
.drawer-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px;
  margin-bottom: 4px; }
.drawer-head h2 { margin: 0; }
.drawer-head .close { margin-left: auto; }
/* The text sent to the AI, at the end, when asked for: long, so it scrolls. */
.prompt-sent { margin-top: 12px; border: 1px solid var(--border); border-radius: 6px;
  padding: 8px 12px; }
.prompt-sent > summary { cursor: pointer; display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 4px 12px; }
.prompt-sent > summary h2 { display: inline; margin: 0; }
.prompt-text { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.85em;
  max-height: 70vh; overflow: auto; margin: 8px 0 0; }
.verdict { font-weight: 600; padding: 0 8px; border-radius: 999px; }
.verdict-improves { color: var(--add); background: var(--ins-line); }
.verdict-mixed { color: var(--fmt); background: var(--fmt-bg); }
.verdict-worsens { color: var(--rem); background: var(--del-line); }
/* whether the new text reads as written by an AI */
.verdict-likely { color: var(--rem); background: var(--del-line); }
.verdict-possibly { color: var(--fmt); background: var(--fmt-bg); }
.verdict-unlikely { color: var(--add); background: var(--ins-line); }
.assess-body { max-width: 80em; }
.assess-body h1, .assess-body h2, .assess-body h3 { font-size: 14px; margin: 14px 0 4px; }
.assess-body p, .assess-body ul, .assess-body ol { margin: 4px 0; }
.assess-body li { margin: 2px 0; }
.assess-body code { font-size: 0.9em; background: var(--panel); padding: 0 3px; border-radius: 3px; }
.assess-note { font-size: 12px; margin: 10px 0 2px; }
/* The problems the AI marked: in the text, a numbered badge before each
   passage; its card in the margin. */
.ai-pointer { margin: 10px 0 2px; }
.ai-mark { display: inline-block; font: 600 11px/1.4 -apple-system, "Segoe UI", sans-serif;
  color: var(--bg); background: var(--current); border-radius: 8px; padding: 0 5px;
  margin-right: 3px; vertical-align: 1px; }
.assess-error { color: var(--rem); margin: 6px 0 2px; }
.summary { color: var(--muted); margin-bottom: 12px; }
.summary p { margin: 0 0 4px; display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 4px 8px; }
.expand { font: inherit; color: var(--link); background: none;
  border: 0; padding: 0; cursor: pointer; }
.expand:hover { text-decoration: underline; }
.add { color: var(--add); } .rem { color: var(--rem); }
nav ul { list-style: none; padding: 0; margin: 0 0 24px;
  border: 1px solid var(--border); border-radius: 6px; }
nav li { padding: 4px 12px; border-top: 1px solid var(--border);
  display: flex; gap: 12px; flex-wrap: wrap; }
nav li:first-child { border-top: 0; }
nav a { color: inherit; flex: 1; overflow-wrap: anywhere; }
nav .change { color: var(--muted); min-width: 7em; }
/* Clipped to its rounded corners without being a scroll box of its own
   (overflow: hidden would be one): its header sticks under the top bar. */
details.file { position: relative; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 24px;
  overflow: clip; }
details.file > summary { background: var(--panel); padding: 8px 12px; cursor: pointer;
  display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline;
  position: sticky; top: var(--bar-h); z-index: 2; }
details.file[open] > summary { border-bottom: 1px solid var(--border); }
.path { font-family: ui-monospace, Consolas, monospace; font-weight: 600;
  overflow-wrap: anywhere; }
.note { padding: 12px; color: var(--muted); }
.file-note { color: var(--muted); font-style: italic; }
/* A language's flag: in the file header, or before each paragraph's number;
   the flags the HTML report shows follow, each an SVG of flag-icons. */
.flag { display: inline-block; width: 1.33em; height: 1em; vertical-align: -.12em;
  background: center / cover no-repeat; box-shadow: 0 0 0 1px rgba(0, 0, 0, .15);
  font-style: normal; line-height: 1; cursor: help; }
.flag.globe { width: auto; box-shadow: none; }
td.no .flag { float: left; font-size: .8em; margin-top: .3em; }
.images { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px; }
.images figure { margin: 0; text-align: center; }
.images img { max-width: 100%; height: auto; background:
  repeating-conic-gradient(#8883 0 25%, transparent 0 50%) 0 0 / 16px 16px; }
.images figcaption { color: var(--muted); font-size: 12px; }
.images .old img { outline: 3px solid var(--del-word); }
.images .new img { outline: 3px solid var(--ins-word); }
table { width: 100%; border-collapse: collapse; table-layout: fixed;
  font: 12px/1.45 ui-monospace, Consolas, "Liberation Mono", monospace; }
col.no { width: 5.5em; }
td { vertical-align: top; padding: 0 8px; }
/* Prose: some space between paragraphs (their blank lines are not shown),
   set with the spacing stepper. */
:root { --para-gap: 0.75em; }
table.prose td.code, table.prose td.no { padding-bottom: calc(var(--para-gap) + var(--push, 0px)); }
/* --push: room made after a row (by the script), so the next row's cards
   start beside it when the cards above run on down to it. */
td.code, td.no { padding-bottom: var(--push, 0px); }
.spacing { display: inline-flex; align-items: center; gap: 6px; }
td.no { color: var(--muted); text-align: right; user-select: none;
  border-right: 1px solid var(--border); white-space: nowrap; }
/* +, − and ~ in the gutter: the kind of change without relying on colour. */
.sign { display: inline-block; width: 1.1em; text-align: center; font-weight: 700; }
tr.delete .sign, tr.replace td.l .sign, tr.moved-out .sign { color: var(--rem); }
tr.insert .sign, tr.replace td.r .sign, tr.moved-in .sign { color: var(--add); }
tr.moved-out .sign, tr.moved-in .sign { color: var(--move); }
/* Long lines wrap instead of scrolling sideways, so prose stays readable.
   Justified, the last line of each wrapped line stays ragged. */
td.code { white-space: pre-wrap; overflow-wrap: anywhere;
  text-align: {{ align }}; text-align-last: start; }
/* Prose collapses its spaces: one at the end of a wrapped line is dropped,
   so a highlighted one neither hangs past the edge (into the next column)
   nor sticks out of the justified text. Code keeps every space. */
table.prose td.code { white-space: pre-line; }
td.code.left { border-right: 1px solid var(--border); }
/* Wholly removed and added lines are tinted; an edited line is not, only its
   changed words are (its gutter keeps the tint and the ~ sign), so the
   unchanged text of an edited paragraph does not look changed. */
/* A cell's tint is --tint, painted above the space between paragraphs so
   that the space stays blank and paragraphs stay apart. */
td { --tint: transparent; --tint-gap: 0px;
  background: linear-gradient(var(--tint), var(--tint)) no-repeat top left /
    100% calc(100% - var(--tint-gap)); }
table.prose td.code, table.prose td.no { --tint-gap: calc(var(--para-gap) + var(--push, 0px)); }
td.code, td.no { --tint-gap: var(--push, 0px); }
tr.delete td.left { --tint: var(--del-line); }
tr.insert td.right { --tint: var(--ins-line); }
tr.delete td.no.l, tr.replace td.no.l { --tint: var(--del-line); }
tr.insert td.no.r, tr.replace td.no.r { --tint: var(--ins-line); }
del { background: var(--del-word); text-decoration: none; border-radius: 2px; }
ins { background: var(--ins-word); text-decoration: none; border-radius: 2px; }
/* A word changed into a similar one: light background, changed letters strong. */
del.partial { background: var(--del-line); }
ins.partial { background: var(--ins-line); }
del.partial mark { background: var(--del-word); color: inherit; }
ins.partial mark { background: var(--ins-word); color: inherit; }
.comment { cursor: help; }
tr.moved-out td.left, tr.moved-in td.right,
tr.moved-out td.no.l, tr.moved-in td.no.r { --tint: var(--move-line); }
tr.moved-out td.no.l, tr.moved-in td.no.r { color: var(--move); font-weight: 600; }
/* A passage moved within a line or between two is drawn as a moved line is:
   tinted in the colour of moves (its words edited on the way marked inside
   it), where it went or came from on hover and on paper, a line between its
   two ends. A line removed or added whose words all moved is a moved line
   in all but name: tinted, its number in the colour of moves, → or ←. */
.moved { background: var(--move-line); cursor: help; }
.moved.pair-hot { outline: 1px solid var(--move); outline-offset: -1px; }
body.passages tr.only-moved.delete td.left, body.passages tr.only-moved.delete td.no.l,
body.passages tr.only-moved.insert td.right, body.passages tr.only-moved.insert td.no.r {
  --tint: var(--move-line); }
body.passages tr.only-moved.delete td.no.l, body.passages tr.only-moved.insert td.no.r {
  color: var(--move); font-weight: 600; }
body.passages tr.only-moved .sign { color: var(--move); }
/* The "Change highlights" view off: no background on the text, neither on
   changed words and letters, nor on lines removed, added or moved, nor on
   moved passages; the gutters keep their tint and signs, which say where
   the changes are. */
body:not(.highlights) td.code { --tint: transparent !important; }
body:not(.highlights) :is(del, ins, del.partial, ins.partial, del.partial mark,
  ins.partial mark, .moved) { background: none; }
/* The "Moved passages" switch: off, a row shows its plain word diff, each
   passage removed and added in place, and the counts follow. */
body:not(.passages) .pv-on, body.passages .pv-off { display: none; }
/* The split switch shows the split shown: a block of lines (paragraphs),
   or a line ending in a full stop (sentences). */
.toolbar .split-switch .sentences, .toolbar .split-switch[aria-pressed="true"] .paragraphs { display: none; }
.toolbar .split-switch[aria-pressed="true"] .sentences { display: inline; }
.toolbar .split-switch { gap: 4px; padding: 4px 6px; }
.toolbar .split-switch .split-name { font-size: 12px; }
/* Which view is shown: a pill at the head of the summary, with a button
   to the other view when the report holds both. */
.view-label { display: inline-flex; align-items: baseline; gap: 2px; padding: 0 2px 0 8px;
  border: 1px solid var(--link); border-radius: 999px; background: var(--skip);
  color: var(--fg); }
.view-label b { font-weight: 600; }
.view-label:not(:has(button)) { padding-right: 8px; }
/* A line from each moved line to where it went, over the file's table;
   hovering either end highlights both rows and their line. Hidden in one
   column, where both ends stand in one column, and on paper. */
svg.move-links { position: absolute; left: 0; top: 0; pointer-events: none; overflow: visible; }
svg.move-links path { fill: none; stroke: var(--move); stroke-width: 1.5; opacity: .5; }
svg.move-links circle { fill: var(--move); opacity: .7; }
svg.move-links .hot path, svg.move-links .hot circle { opacity: 1; }
svg.move-links .hot path { stroke-width: 2.5; }
body:not(.movelinks) svg.move-links, body.unified svg.move-links { display: none; }
tr.pair-hot td { outline: 1px solid var(--move); outline-offset: -1px; }
/* A moved line's number tells, on hover, where the line went or came from. */
td[data-move] { cursor: help; }
.comment { font-size: 0.85em; background: var(--panel); border-radius: 3px;
  padding: 0 2px; }
/* A new or removed comment's icon says it all: no box around it. A new
   one is a green balloon with a + in it, in the text and in the panel. */
.comment.new, .comment.removed { background: none; padding: 0; }
svg.new-comment { width: 1.35em; height: 1.35em; vertical-align: -0.3em; }
svg.new-comment path { fill: var(--add); }
svg.new-comment .plus { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; }
/* The one tooltip of the HTML report, for the toolbar's help, where a moved
   line went, formatting and tracked changes. The script places it next to
   what is hovered or focused, so no file box clips it. */
#tip { position: fixed; z-index: 3; max-width: 32em; padding: 6px 10px;
  background: var(--bg); color: var(--fg); border: 1px solid var(--border);
  border-radius: 6px; box-shadow: 0 2px 8px #0003; pointer-events: none;
  font: 13px/1.4 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  text-align: left; white-space: normal; overflow-wrap: anywhere; }
#tip b, #tip .line { display: block; }
#tip .when { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
tr.current td, tr.target td { box-shadow: inset 0 2px 0 var(--current); }
tr.skip td { background: var(--skip); padding: 2px 8px;
  font-family: -apple-system, "Segoe UI", sans-serif; }
/* room made after a fold, as after a row (--push): blank, under its band */
tr.skip td { padding-bottom: calc(2px + var(--push, 0px));
  background: linear-gradient(var(--skip), var(--skip)) no-repeat top left /
    100% calc(100% - var(--push, 0px)); }
tr.skip .omitted { color: var(--muted); }
/* Formatted view: Markdown syntax hidden, what it marks styled, and prose
   in a proportional font. */
body.formatted td.code { font-family: Georgia, "Times New Roman", serif; font-size: 14px; }
body.formatted .s-syn { display: none; }
body.formatted .s-em { font-style: italic; }
body.formatted .s-strong { font-weight: 700; }
body.formatted .s-code { font-family: ui-monospace, Consolas, monospace; font-size: 0.9em;
  background: var(--panel); }
body.formatted .s-link { color: var(--link); text-decoration: underline; }
body.formatted .s-u { text-decoration: underline; }
body.formatted .s-strike { text-decoration: line-through; }
body.formatted .s-u.s-strike { text-decoration: underline line-through; }
body.formatted .s-sup { vertical-align: super; font-size: 0.75em; line-height: 0; }
body.formatted .s-sub { vertical-align: sub; font-size: 0.75em; line-height: 0; }
/* Formatting changes (a document's text made bold, underlined, ...), shown
   by default, dotted in amber, what changed on hover, and a count in each
   file's header; the toolbar's switch hides them. */
.fmt-count { display: none; color: var(--fmt); }
body.formats .fmt-count { display: inline; }
body.formats .fmt { background: var(--fmt-bg); border-bottom: 2px dotted var(--fmt);
  cursor: help; }
body.formats tr.fmt-row td.no { color: var(--fmt); font-weight: 600; }
body.formatted .s-cite { color: var(--move); }
/* Tracked changes kept as markup (--docx-changes all), as Word shows them:
   insertions underlined, deletions struck through; hovering one says who
   made it and when. */
body.formatted .s-tc-ins { text-decoration: underline 2px var(--add);
  text-underline-offset: 2px; cursor: help; }
body.formatted .s-tc-del { text-decoration: line-through var(--rem);
  color: var(--muted); cursor: help; }
body.formatted .s-quote { font-style: italic; color: var(--muted); }
body.formatted .s-h1, body.formatted .s-h2, body.formatted .s-h3,
body.formatted .s-h4, body.formatted .s-h5, body.formatted .s-h6 { font-weight: 700; }
body.formatted .s-h1 { font-size: 1.4em; } body.formatted .s-h2 { font-size: 1.25em; }
body.formatted .s-h3 { font-size: 1.1em; }
footer { color: var(--muted); font-size: 12px; margin-bottom: 48px; }
footer a { color: inherit; }
/* The top bar: what is compared, the AI's verdict (opening its assessment),
   the way through the changes, the comments and the problems, review mode
   and the views; it stays at the top as the page scrolls. */
.toolbar { position: sticky; top: 0; z-index: 4; margin: 0 -16px; display: flex;
  gap: 6px 14px; align-items: center; flex-wrap: wrap; padding: 7px 16px;
  background: var(--panel); color: var(--fg); border-bottom: 1px solid var(--border);
  font-size: 13px; }
.toolbar button { font: inherit; color: var(--link); background: none; border: 0;
  padding: 0 4px; cursor: pointer; }
.toolbar .bar-title { font-weight: 600; min-width: 0; max-width: 34em; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
.toolbar .spacer { flex: 1; }
.toolbar .group { display: inline-flex; align-items: center; gap: 2px; }
.toolbar .verdict-button { display: inline-flex; align-items: center; gap: 8px; padding: 3px 8px;
  border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); }
.toolbar .verdict-button:hover, .toolbar .verdict-button[aria-expanded="true"] {
  border-color: var(--link); }
.toolbar .verdict-button .role { font-size: 12px; }
.toolbar .review-button { padding: 3px 10px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg); }
.toolbar .review-button[aria-pressed="true"] { background: var(--skip); color: var(--fg);
  border-color: var(--link); font-weight: 600; }
.toolbar .comment-counter { color: var(--add); font-weight: 600; min-width: 4em;
  text-align: center; font-variant-numeric: tabular-nums; }
.toolbar button[aria-pressed="true"] { font-weight: 700; }
/* Icon buttons: the view switches, drawn in the text colour; a pressed one
   sits on a tinted square. */
.toolbar button.icon { display: inline-flex; padding: 4px; border-radius: 5px; }
.toolbar button.icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
.toolbar button.icon svg .fill { fill: currentColor; stroke: none; }
.spacing-icon { display: inline-flex; color: var(--link); }
.spacing-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
.toolbar button.icon[aria-checked="true"] { background: var(--skip);
  box-shadow: inset 0 0 0 1px var(--link); }
.toolbar button.icon[aria-checked="false"] { color: var(--muted); }
.toolbar button.icon svg .soft { opacity: 0.3; }
.toolbar button.icon:hover { background: var(--skip); }
.toolbar button.icon[aria-pressed="true"] { background: var(--skip);
  box-shadow: inset 0 0 0 1px var(--link); }
.toolbar button:disabled { color: var(--muted); cursor: default; }
/* The View menu: the switches few use, each named, under the top bar. */
.toolbar .menu { position: relative; display: inline-flex; }
.toolbar .menu-button { display: inline-flex; align-items: center; gap: 2px;
  padding: 3px 6px; border-radius: 5px; }
.toolbar .menu-button:hover, .toolbar .menu-button[aria-expanded="true"] { background: var(--skip); }
.menu-panel { position: absolute; right: 0; top: calc(100% + 10px); z-index: 5; display: flex;
  flex-direction: column; gap: 2px; min-width: 16em; padding: 6px; background: var(--panel);
  border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 2px 8px #0003; }
.menu-panel[hidden] { display: none; }
.toolbar .menu-panel button.icon, .menu-panel .item { display: flex; align-items: center;
  gap: 8px; width: 100%; padding: 4px 6px; color: var(--fg); text-align: left; }
.menu-panel .label { flex: 1; white-space: nowrap; }
/* On or off shows in the tinted box alone: the names stay one weight. */
.toolbar .menu-panel button[aria-pressed="true"] { font-weight: inherit; }
.menu-panel kbd { font: 11px ui-monospace, monospace; color: var(--muted);
  border: 1px solid var(--border); border-radius: 3px; padding: 0 4px; }
.toolbar .counter { color: var(--muted); min-width: 4.5em; text-align: center;
  font-variant-numeric: tabular-nums; }
/* The comments' and the problems' own ◀ ▶, apart from the changes'. */
.toolbar .ai-nav, .toolbar .comment-nav { display: inline-flex; align-items: center; gap: 2px;
  padding-left: 8px; border-left: 1px solid var(--border); }
.toolbar .ai-counter { color: var(--current); font-weight: 600; min-width: 4em;
  text-align: center; font-variant-numeric: tabular-nums; }
.toolbar label { display: inline-flex; gap: 4px; align-items: center; cursor: pointer; }
/* The spacing stepper: − and + either side of the value, in one bordered
   row, drawn in the link colour like the icons. */
.stepper { display: inline-flex; align-items: stretch;
  border: 1px solid var(--border); border-radius: 5px; overflow: hidden;
  background: var(--bg); }
.toolbar .stepper button { padding: 0; width: 22px; line-height: 1;
  font-size: 16px; font-weight: 700; color: var(--link); background: var(--panel); }
.toolbar .stepper button:hover:not(:disabled) { color: var(--link); background: var(--skip); }
.toolbar .stepper button:disabled { color: var(--border); }
.stepper .gap-value:focus-visible { outline: 2px solid var(--link); outline-offset: -2px; }
.stepper .gap-value { min-width: 2.6em; text-align: center; padding: 3px 4px;
  font-size: 12px; font-variant-numeric: tabular-nums;
  border-inline: 1px solid var(--border); }
/* Review mode: the list of what there is to review down the left (the
   assessment, the changes, the comments, the problems), and, beside it,
   the one row it is in, with its cards, under a line saying which it is
   and the buttons to the previous and the next. */
#review-list, #review-head { display: none; }
body.review #review-list { display: block; position: fixed; left: 0; top: var(--bar-h);
  bottom: 0; width: var(--review-w); z-index: 2; overflow: auto; padding: 8px 0 24px;
  background: var(--bg); border-right: 1px solid var(--border); font-size: 13px; }
body.review main { margin-left: calc(var(--review-w) - 16px + 24px); }
#review-list h3 { margin: 14px 16px 4px; font-size: 11px; font-weight: 600; letter-spacing: .06em;
  text-transform: uppercase; color: var(--muted); }
#review-list button { display: flex; gap: 8px; width: 100%; padding: 6px 16px; border: 0;
  background: none; color: var(--fg); font: inherit; text-align: left; cursor: pointer; }
#review-list button:hover { background: var(--skip); }
#review-list button[aria-current="true"] { background: var(--fmt-bg);
  box-shadow: inset 3px 0 0 var(--current); font-weight: 600; }
#review-list button:disabled { color: var(--muted); cursor: default; background: none; }
#review-list .ref { flex-shrink: 0; min-width: 2.6em; color: var(--muted);
  font: 12px/1.6 ui-monospace, Consolas, monospace; }
#review-list .ref.warn { color: var(--current); font-family: inherit; font-weight: 600; }
#review-list .what { min-width: 0; overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; }
#review-list ins, #review-list del { padding: 0 2px; }
body.review #review-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px;
  margin: 0 0 12px; }
#review-head .which { font-weight: 600; padding: 2px 10px; border-radius: 999px;
  background: var(--fmt-bg); color: var(--fmt); }
#review-head .where { color: var(--muted); }
#review-head .spacer { flex: 1; }
#review-head button { font: inherit; padding: 5px 14px; border-radius: 6px; cursor: pointer;
  border: 1px solid var(--border); background: var(--bg); color: var(--fg); }
#review-head button.next { background: var(--fg); color: var(--bg); border-color: var(--fg); }
body.review header, body.review .commits, body.review .summary,
body.review nav[aria-label="Changed files"], body.review footer, body.review .prompt-sent,
body.review details.file:not(.review-file) { display: none; }
body.review details.file tbody tr:not(.review-row) { display: none; }
/* Single column: each row shows the old line above the new one; unchanged
   and added lines show their new side only, removed lines their old side;
   the cards beside them. */
body.unified colgroup { display: none; }
body.unified table, body.unified tbody { display: block; }
body.unified tbody[hidden] { display: none; }
body.unified tr { display: grid; grid-template-columns: 5.5em 1fr; }
body.unified table.notes-on tr { grid-template-columns: 5.5em 1fr var(--notes-w); }
body.unified td.no { grid-column: 1; }
body.unified td.code { grid-column: 2; }
body.unified td.notes { grid-column: 3; grid-row: 1 / span 2; }
body.unified .stack { position: static; margin: 4px 8px; }
body.unified td.code.left { border-right: 0; }
body.unified tr.equal td.l, body.unified tr.equal td.left,
body.unified tr.insert td.l, body.unified tr.insert td.left,
body.unified tr.moved-in td.l, body.unified tr.moved-in td.left,
body.unified tr.delete td.r, body.unified tr.delete td.right,
body.unified tr.moved-out td.r, body.unified tr.moved-out td.right { display: none; }
body.unified tr.skip td { grid-column: 1 / -1; }
/* A narrow window: the cards under their row, across both versions. */
@media screen and (max-width: 1100px) {
  table.notes-on colgroup { display: none; }
  table.notes-on, table.notes-on tbody { display: block; }
  table.notes-on tbody[hidden] { display: none; }
  table.notes-on tr { display: grid; grid-template-columns: 4em 1fr 4em 1fr; }
  table.notes-on td.notes { grid-column: 1 / -1; grid-row: auto; border-left: 0; }
  .stack { position: static; margin: 4px 8px 8px; }
  table.notes-on td.notes:empty { display: none; }
  table.notes-on tr.skip td { grid-column: 1 / -1; }
  body.unified table.notes-on tr { grid-template-columns: 4em 1fr; }
  body.unified table.notes-on td.notes { grid-column: 1 / -1; grid-row: auto; }
  :root { --review-w: 240px; }
}
/* Shown only on paper: the column headings repeated on every page of a
   file, and where a moved line went. */
thead.print, .print-note { display: none; }
@page { margin: 14mm 12mm; }
@media print {
  body { padding: 0; font-size: 11px; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .toolbar, .btn, #review-list, #review-head, .drawer .close, .card .more { display: none !important; }
  body.review main { margin-left: 0; }
  /* The assessment at the top, whether opened or not. */
  .drawer, .drawer[hidden] { display: block; position: static; width: auto; box-shadow: none;
    border: 1px solid var(--border); border-radius: 6px; margin-bottom: 12px; overflow: visible; }
  /* Every card whole, beside its row. */
  .card .body.clamped { display: block; overflow: visible; }
  col.notes { width: 26%; }
  .card { break-inside: avoid; }
  .stack { position: static; margin: 2px 4px; }
  details.file { padding-bottom: 0 !important; }
  .view-label { border: 0; background: none; padding: 0; }
  /* No disclosure triangles: nothing to click on paper. */
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  details.file > summary { break-after: avoid; }
  h1, h2 { break-after: avoid; }
  /* The repeated headings: which file, which side. */
  thead.print { display: table-header-group; }
  thead.print th { text-align: left; font-weight: 600; font-size: 10px; color: var(--muted);
    padding: 3px 8px; border-bottom: 1px solid var(--border); background: var(--panel); }
  thead.print .path { font-size: inherit; }
  body.unified thead.print { display: none; }
  /* Folded unchanged lines: a quiet separator, not a button. */
  tr.skip td { background: none; border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border); padding: 1px 8px; }
  tr.skip .expand { color: var(--muted); padding: 0; }
  tr.skip .expand .verb { display: none; }
  .print-note { display: block; font-family: -apple-system, "Segoe UI", sans-serif;
    font-size: 0.85em; color: var(--move); }
  /* where a moved passage went, right after it */
  .print-note.passage { display: inline; }
  details.file > summary { position: static; }
  /* Nothing clipped: a clipping box makes the browser cut through the line
     at the foot of a page. */
  details.file { overflow: visible; }
  /* The spaces of code at the end of a wrapped line take room on it instead
     of hanging past the edge, where a highlighted one would run into the
     next column. */
  td.code { white-space: break-spaces; }
  table.prose td.code { white-space: pre-line; }
  /* A narrow gutter leaves the text columns as wide as a portrait page
     allows. */
  col.no { width: 3.6em; }
  body.unified tr { grid-template-columns: 3.6em 1fr; }
  body.unified table.notes-on tr { grid-template-columns: 3.6em 1fr 30%; }
  td.no { padding: 0 4px; }
  /* A long paragraph continues on the next page rather than leaving the
     rest of this one blank, never with a lone line either side. */
  tr { break-inside: auto; }
  td { orphans: 3; widows: 3; }
  tr.skip { break-inside: avoid; }
  tr.current td, tr.target td { box-shadow: none; }
}
{{ flag_css }}
</style>
</head>
<body>
{% set marks = assessment and assessment.annotations and not assessment.error %}
<div class="toolbar" role="toolbar" aria-label="Changes and views">
  <span class="bar-title" title="{{ c.base.short }} → {{ c.target.short }}">{{ c.base.short }} → {{ c.target.short }}</span>
  {% if assessment %}<button type="button" class="verdict-button" data-drawer="assessment" aria-expanded="false" aria-controls="assessment" title="AI assessment: what the AI made of the changes as a whole">{% if assessment.error %}<span class="verdict verdict-worsens">failed</span>{% elif assessment.verdict %}<span class="verdict verdict-{{ assessment.verdict }}">{{ assessment.verdict | capitalize }}</span>{% endif %}<span class="role">AI assessment</span></button>{% endif %}
  {% if writing %}<button type="button" class="verdict-button" data-drawer="writing" aria-expanded="false" aria-controls="writing" title="AI writing: whether the new text reads as written by an AI, an indication, not a proof">{% if writing.error %}<span class="verdict verdict-likely">failed</span>{% elif writing.verdict %}<span class="verdict verdict-{{ writing.verdict }}">{{ writing.verdict | capitalize }}</span>{% endif %}<span class="role">AI writing</span></button>{% endif %}
  <span class="spacer"></span>
  <span class="group" role="group" aria-label="Changes">
  <button type="button" data-nav="-1" title="Previous change (p)" aria-label="Previous change">◀</button>
  <span class="counter" aria-live="polite" title="{{ c.change_count | counted("change") }}">{{ c.change_count | comma }}</span>
  <button type="button" data-nav="1" title="Next change (n)" aria-label="Next change">▶</button></span>
  <span class="comment-nav" role="group" aria-label="Comments" hidden>
    <button type="button" data-comment-nav="-1" title="Previous comment (Shift+C)" aria-label="Previous comment">◀</button>
    <span class="comment-counter" aria-live="polite" title="Comments: those added or removed since the base, in the margin">0 comments</span>
    <button type="button" data-comment-nav="1" title="Next comment (c)" aria-label="Next comment">▶</button></span>
  {% if marks %}<span class="ai-nav" role="group" aria-label="Problems">
    <button type="button" data-ai-nav="-1" title="Previous problem (Shift+A)" aria-label="Previous problem">◀</button>
    <span class="ai-counter" aria-live="polite" title="Problems: those the AI marked in the text, ⚠ in the text and in the margin">⚠ {{ assessment.annotations | length | counted("problem") }}</span>
    <button type="button" data-ai-nav="1" title="Next problem (a)" aria-label="Next problem">▶</button></span>{% endif %}
  {% if marks or c.comments or (alt and alt.comments) %}<button type="button" class="margin-button" data-toggle="margin" aria-pressed="true" title="Margin: the cards of the comments and the problems beside the text; off, the two versions take its width (g)">Margin</button>{% endif %}
  <button type="button" class="review-button" data-review aria-pressed="false" title="Review: the changes, the comments and the problems listed, to go through one by one (r)">Review</button>
  {% if alt %}<button type="button" class="icon split-switch" data-split-switch aria-pressed="false" aria-label="Compared paragraph by paragraph" title="Paragraphs: shown compared paragraph by paragraph; switch to sentence by sentence (s)"><svg class="paragraphs" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h10M2 6.3h12M2 9.7h12M2 13h7"/></svg><svg class="sentences" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 8h10"/><circle cx="14" cy="8" r="1.4" class="fill"/></svg><span class="split-name" aria-hidden="true">Paragraphs</span></button>{% endif %}
  <button type="button" class="icon" data-toggle="movelinks" aria-pressed="false" aria-label="Lines between moves" title="Lines between moves: a line from each moved paragraph, and each moved passage, to where it went (l)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5c6 0 6 9 12 9"/><circle cx="2" cy="3.5" r="1.5" class="fill"/><circle cx="14" cy="12.5" r="1.5" class="fill"/></svg></button>
  {% if c.counts.moved_passages or (alt and alt.counts.moved_passages) %}<button type="button" class="icon" data-toggle="passages" aria-pressed="false" aria-label="Moved passages" title="Moved passages: words moved within a paragraph or sentence, or between two, shown as moved; off, as removed and added in place (v)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3h13M1.5 13h13"/><rect x="1.5" y="6" width="6" height="4" rx="1" class="fill soft"/><path d="M9 8h5.5M12.5 6l2 2-2 2"/></svg></button>{% endif %}
  <button type="button" class="icon" data-toggle="unified" aria-pressed="false" aria-label="One column" title="One column: old line above new line (u)"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="1.5" width="9" height="13" rx="1.5"/><path d="M5.5 5h5M5.5 8h5M5.5 11h5"/></svg></button>
  <span class="menu">
    <button type="button" class="menu-button" aria-haspopup="true" aria-expanded="false" aria-controls="view-menu">View<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
    <div class="menu-panel" id="view-menu" role="group" aria-label="More views" hidden>
      <button type="button" class="icon" data-toggle="formatted" aria-pressed="false" aria-label="Formatted" title="Formatted: Markdown shown formatted instead of raw (f)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 13 5 3l3.5 10M2.7 9.6h4.6"/><path d="M10 13V7.5h2.6a1.6 1.6 0 0 1 0 3.2H10m0 0h3a1.2 1.2 0 0 1 0 2.3h-3"/></svg><span class="label">Formatted</span><kbd aria-hidden="true">f</kbd></button>
      <button type="button" class="icon" data-toggle="highlights" aria-pressed="true" aria-label="Change highlights" title="Change highlights: the background colour of changed words and lines; off, the text plain, the gutters still marking the changes (h)"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="5" width="13" height="6" rx="1" class="fill soft"/><path d="M4 8h8"/></svg><span class="label">Change highlights</span><kbd aria-hidden="true">h</kbd></button>
      <button type="button" class="icon" data-toggle="formats" aria-pressed="false" aria-label="Formatting changes" title="Formatting changes: text of a document made bold, italic, underlined, ..., its words unchanged (m)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h4.2a2.6 2.6 0 0 1 0 5.2H4zM4 7.7h4.8a2.9 2.9 0 0 1 0 5.8H4z"/><path d="M11.5 11.5l1.5 1.5 2.5-3" /></svg><span class="label">Formatting changes</span><kbd aria-hidden="true">m</kbd></button>
      <span class="spacing item"><span class="spacing-icon" title="Space between paragraphs" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 1.5v13M1.2 3.3 3 1.5l1.8 1.8M1.2 12.7 3 14.5l1.8-1.8M7 3h7.5M7 6.3h7.5M7 9.7h7.5M7 13h7.5"/></svg></span><span class="label">Paragraph spacing</span>
    <span class="stepper">
      <button type="button" tabindex="-1" aria-hidden="true" data-gap="-1" title="Less space between paragraphs ([)">−</button>
      <span class="gap-value" role="spinbutton" tabindex="0" aria-label="Space between paragraphs"
        aria-valuemin="0" aria-valuemax="3" aria-valuenow="0.75" aria-valuetext="0.75 lines"
        title="Space between paragraphs, in lines: arrow keys to change, Home for none, End for the most">0.75</span>
      <button type="button" tabindex="-1" aria-hidden="true" data-gap="1" title="More space between paragraphs (])">+</button>
    </span></span>
    </div>
  </span>
</div>
<nav id="review-list" aria-label="Review"></nav>
<main>
<header>
<h1>{{ c.repo_name }}{% if c.location %}<span class="full-path">{{ c.location }}</span>{% endif %}</h1>

{# A paragraph's language in the gutter, when the file's paragraphs differ. #}
{% macro gutter_flag(f, no, lang) -%}
{% if f.mixed_languages and no is not none %}{{ flag(lang or f.language, paragraph_language_note(lang, f.language, f.language_source)) }}{% endif %}
{%- endmacro %}
{% macro side(r) -%}
{{ r.subject }}{% if r.author or r.date %} <span class="role">— {{ r.author }}{% if r.author and r.date %}, {% endif %}{{ r.date }}</span>{% endif %}
{%- endmacro %}
<div class="revisions">
  {% for label, r in (("Base (older)", c.base), ("Target (newer)", c.target)) %}
  <span class="role">{{ label }}</span>
  <code title="{{ r.hexsha }}">{{ r.short }}</code>
  <span>{{ side(r) }}</span>
  {% if not c.location %}<span class="full-path">{{ r.hexsha }}</span>{% else %}<span></span>{% endif %}
  {% endfor %}
</div>
</header>

{% if c.commits %}
<details class="commits"{% if c.commits_total <= 10 %} open{% endif %}>
  <summary>{{ c.commits_total | counted("commit") }} in between{% if c.target.short in ("working tree", "index") %}, up to HEAD{% endif %}</summary>
  <ol>
  {% for r in c.commits %}
    <li><code title="{{ r.hexsha }}">{{ r.short }}</code><span class="role">{{ r.date }}</span><span>{{ r.subject }} <span class="role">— {{ r.author }}</span></span></li>
  {% endfor %}
  {% if c.commits_total > c.commits | length %}
    <li><span></span><span></span><span class="role">… and {{ (c.commits_total - c.commits | length) | comma }} older</span></li>
  {% endif %}
  </ol>
</details>
{% endif %}

{# What a row shows with moved passages (on) and without (off, None when
   the row has none): both, the "Moved passages" switch showing one. #}
{% macro pv(on, off) -%}
{% if off is none %}{{ on }}{% else %}<span class="pv-on">{{ on }}</span><span class="pv-off">{{ off }}</span>{% endif %}
{%- endmacro %}

{# The two cells of one side of a row: its gutter (flag, number or label)
   and its text. A hidden row (spoken none) shows no more; a row of the
   table its sign too, what a screen reader says of it (spoken), and, when
   it moved, where it went or came from. #}
{% macro cells(f, r, side, spoken=none, sign="", plain=none) -%}
{% set left = side == "left" %}{% set no, lang, label = r[side ~ "_no"], r[side ~ "_lang"], r[side ~ "_label"] %}{% set end = "moved-out" if left else "moved-in" %}{% set move = r.changes[0] if spoken is not none and r.kind == end and r.changes else "" %}
<td class="no {{ "l" if left else "r" }}"{% if move %} data-move="{{ move | replace(", edited:", "") | capitalize }}"{% if ", edited:" in move %} data-move-edited{% endif %}{% endif %}>{{ gutter_flag(f, no, lang) }}{% if spoken is none %}{{ label or no }}{% else %}{{ (label or no) if no is not none else "" }}<span class="sign" aria-hidden="true">{{ sign }}</span>{% endif %}</td>
{%- if spoken is none %}<td class="code {{ side }}"{% if lang and lang != f.language %} lang="{{ lang }}"{% endif %}>{{ r[side] | hyphenate(lang or f.language) }}</td>
{%- else %}<td class="code {{ side }}"{% if lang and lang != f.language %} lang="{{ lang }}"{% endif %}>{% if r.kind in spoken and no is not none %}<span class="sr">{{ spoken[r.kind] }}, {{ "old" if left else "new" }}: </span>{% endif %}{{ pv(r[side] | hyphenate(lang or f.language), plain[side] | hyphenate(lang or f.language) if plain else none) }}{% if move %}<span class="print-note" aria-hidden="true">{{ move | replace(", edited:", "") }}</span>{% endif %}</td>
{%- endif %}
{%- endmacro %}

{# A count as the report shows it with moved passages (on) and without
   (off): one number when both are the same, else both, the "Moved passages"
   switch showing one. #}
{% macro both(on, off) -%}
{% if on == off %}{{ on | comma }}{% else %}<span class="pv-on">{{ on | comma }}</span><span class="pv-off">{{ off | comma }}</span>{% endif %}
{%- endmacro %}

{# The counts of a file or a comparison, its lines called by unit (a
   paragraph, a sentence or a line: unit_of). #}
{% macro counts(x, unit) -%}
{% set n, y = x.counts, x.without_passages %}
<span class="add" title="{{ unit }}s added">+{{ both(n.additions, y.additions) }}</span>
<span class="rem" title="{{ unit }}s removed">−{{ both(n.deletions, y.deletions) }}</span>
<span class="role">{{ unit }}s,</span>
<span class="add" title="words added">+{{ both(n.words_added, y.words_added) }}</span>
<span class="rem" title="words removed">−{{ both(n.words_removed, y.words_removed) }}</span>
<span class="role">words{% if n.moved %}, {{ n.moved | counted("moved " ~ unit) }}{% endif %}{% if n.moved_passages %}<span class="pv-on">, {{ n.moved_passages | counted("moved passage") }}</span>{% endif %}</span>
{%- endmacro %}

{# What a line is in files: a paragraph or a sentence of prose, when all
   are prose, or else a line. #}
{% macro unit_of(files, split) -%}
{% if files and files | selectattr("markdown") | list | length == files | length %}{{ "sentence" if split == "sentence" else "paragraph" }}{% else %}line{% endif %}
{%- endmacro %}
{% macro unit_name(c, split) -%}
{{ unit_of(c.files, split) }}s
{%- endmacro %}

{# Which view this is: prose compared paragraph by paragraph or sentence
   by sentence, and, when the report holds both (other), a button to the
   other. #}
{% macro view_label(split, other=none) -%}
<span class="view-label" title="The prose compared {{ split }} by {{ split }}"><b>{{ split | capitalize }} view</b>{% if other %}<button type="button" class="btn" data-split-to="{{ other }}" title="Show the prose compared {{ other }} by {{ other }} (s)">⇄ {{ other }}s</button>{% endif %}</span>
{%- endmacro %}

{# The body of the report for one comparison: its summary, its files.
   prefix sets its ids apart when the report holds two, one per split;
   other is the other split then. notes: a margin beside each file's rows,
   for the cards of its comments and of the problems the AI marked. #}
{% macro report_body(c, split, prefix="", other=none) %}
{% set notes = (assessment and assessment.annotations and not assessment.error) or c.comments %}
{% set width = 5 if notes else 4 %}
{% if not c.files %}
<p class="summary">No differences between the two sides{% if paths %} in {{ paths | join(", ") }}{% endif %}.</p>
{% else %}
{% set n, y = c.counts, c.without_passages %}
{% set prose = unit_of(c.files, split) != "line" %}
<div class="summary">
  {% if prose or n.changed_lines or n.inserted_lines or n.deleted_lines or n.moved or n.moved_passages %}
  <p class="units">{% if prose %}{{ view_label(split, other) }}{% endif %}
    <span><b>{{ unit_name(c, split) | capitalize }}:</b>
    {{ n.changed_lines | comma }} changed,
    {{ both(n.inserted_lines, y.inserted_lines) }} inserted,
    {{ both(n.deleted_lines, y.deleted_lines) }} deleted,
    {{ n.moved | comma }} moved{% if n.moved_passages %}<span class="pv-on">;
    {{ n.moved_passages | counted("passage") }} moved within or between them</span>{% endif %}{% if paths and c.files | length == 1 %},
    in {{ paths | join(", ") }}{% endif %}</span></p>
  {% endif %}
  {% if c.files | length > 1 %}
  <p class="files-changed"><span>{{ c.files | length | counted("file") }} changed:
  {{ counts(c, unit_of(c.files, split)) }}{% if paths %}, in {{ paths | join(", ") }}{% endif %}</span>
  <button type="button" class="btn" data-files="open">Expand all</button>
  <button type="button" class="btn" data-files="close">Collapse all</button></p>
  {% endif %}
</div>
{% endif %}



{% if c.files %}
{% if c.files | length > 1 %}
<nav aria-label="Changed files"><ul>
{% for f in c.files %}
  <li><span class="change">{{ f.change }}</span><a href="#{{ f.anchor }}">{{ f.path }}</a>
    {% if not f.binary %}<span>{{ counts(f, unit_of([f], split)) }}</span>{% endif %}</li>
{% endfor %}
</ul></nav>
{% endif %}

{% set signs = {"delete": ("−", ""), "insert": ("", "+"), "replace": ("~", "~"), "moved-out": ("→", ""), "moved-in": ("", "←")} %}
{% for f in c.files %}
{% set u = unit_of([f], split) | string %}
{% set spoken = {"delete": "removed " ~ u, "insert": "added " ~ u, "replace": "changed " ~ u, "moved-out": "moved " ~ u ~ ", from here", "moved-in": "moved " ~ u ~ ", to here"} %}
<details class="file" id="{{ f.anchor }}" open>
  <summary>
    <span class="path">{% if f.change == "renamed" %}{{ f.old_path }} → {% endif %}{{ f.path }}</span>
    <span class="role">{{ f.change }}</span>
    {% if not f.binary %}<span>{{ counts(f, u) }}</span>{% endif %}
    {% if f.formatted_rows %}<span class="fmt-count">formatting changed in {{ f.formatted_rows | counted(u) }}</span>{% endif %}
    {% if f.note %}<span class="file-note">{{ f.note }}</span>{% endif %}
    {% if f.language %}<span class="file-note" title="{{ file_language_note(f.language, f.language_source) }}; its sentences are split and its lines hyphenated by it{% if f.mixed_languages %}, where a paragraph is marked with none of its own{% endif %}">{% if not f.mixed_languages %}{{ flag(f.language) }} {% endif %}language: {{ f.language }}{% if f.language_source == "guessed" %} (guessed){% elif f.language_source == "document" %} (from the document){% endif %}</span>{% endif %}
  </summary>
  {% if f.old_image or f.new_image %}
  <div class="images">
    <figure class="old">{% if f.old_image %}<img src="{{ f.old_image }}" alt="old version of {{ f.path }}"><figcaption>old</figcaption>{% else %}<figcaption>(none)</figcaption>{% endif %}</figure>
    <figure class="new">{% if f.new_image %}<img src="{{ f.new_image }}" alt="new version of {{ f.path }}"><figcaption>new</figcaption>{% else %}<figcaption>(none)</figcaption>{% endif %}</figure>
  </div>
  {% elif f.binary %}
  <div class="note">Binary file, not shown.</div>
  {% elif not f.rows %}
  <div class="note">Content unchanged{% if f.change == "renamed" %} (renamed only){% endif %}.</div>
  {% else %}
  <table class="{% if f.markdown %}prose{% endif %}{% if notes %} notes-on{% endif %}"{% if f.language %} lang="{{ f.language }}"{% endif %}>
    <caption class="sr" lang="en">Changes in {{ f.path }}: old version on the left, new version on the right{% if notes %}, comments and problems beside them{% endif %}</caption>
    <colgroup><col class="no"><col><col class="no"><col>{% if notes %}<col class="notes">{% endif %}</colgroup>
    <thead class="print" aria-hidden="true" lang="en"><tr>
      <th colspan="2"><span class="path">{{ f.old_path or f.path }}</span>{% if c.base.short != (f.old_path or f.path) %} · {{ c.base.short }}{% endif %}</th>
      <th colspan="2"><span class="path">{{ f.path }}</span>{% if c.target.short != f.path %} · {{ c.target.short }}{% endif %}</th>
      {% if notes %}<th>Comments and problems</th>{% endif %}
    </tr></thead>
    <tbody>
    {% for r in f.rows %}
    {% if r.kind == "skip" %}
    </tbody>
    {% if r.omitted %}
    <tbody><tr class="skip"><td colspan="{{ width }}"><span class="omitted">⋯ {{ r.omitted | comma }} unchanged lines, left out of the HTML report (rerun with a larger --max-hidden, or --full)</span></td></tr></tbody>
    {% else %}
    <tbody class="fold"><tr class="skip"><td colspan="{{ width }}"><button type="button" class="expand">⋯ <span class="verb">show </span>{{ r.skipped | counted("unchanged line") }}</button></td></tr></tbody>
    <tbody hidden>
    {% for h in r.hidden %}
    <tr class="equal{% if h.format_changes %} fmt-row{% endif %}"{% if h.anchor %} id="{{ h.anchor }}"{% endif %}>{{ cells(f, h, "left") }}{{ cells(f, h, "right") }}{% if notes %}<td class="notes"></td>{% endif %}</tr>
    {% endfor %}
    </tbody>
    {% endif %}
    <tbody>
    {% else %}
    {% set sign = signs.get(r.kind, ("", "")) %}
    {% if r.only_moved %}{% set sign = (pv("→", sign[0]), "") if r.kind == "delete" else ("", pv("←", sign[1])) %}{% endif %}
    {% set plain = r.without_passages %}
    <tr class="{{ r.kind }}{% if r.only_moved %} only-moved{% endif %}{% if r.first_of_change %} first-change{% endif %}{% if r.format_changes %} fmt-row{% endif %}"{% if r.anchor %} id="{{ r.anchor }}"{% endif %}{% if r.move_pair %} data-pair="{{ r.move_pair }}"{% endif %}>
      {{ cells(f, r, "left", spoken, sign[0], plain) }}
      {{ cells(f, r, "right", spoken, sign[1], plain) }}
      {%- if notes %}<td class="notes"></td>{% endif %}
    </tr>
    {% endif %}
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</details>
{% endfor %}
{% endif %}

{% endmacro %}

{# An AI's assessment in its drawer: id, its title, and what to keep in
   mind reading it. #}
{% macro drawer(a, id, title, note) %}
<aside class="drawer" id="{{ id }}" aria-labelledby="{{ id }}-title" hidden>
  <div class="drawer-head"><h2 id="{{ id }}-title">{{ title }}</h2>
    {% if a.verdict %}<span class="verdict verdict-{{ a.verdict }}">{{ a.verdict | capitalize }}</span>{% endif %}
    <span class="role">by {{ a.title }}{% if a.how %}, {{ a.how }}{% endif %}{% if a.seconds %}, in {{ a.took }}{% endif %}</span>
    <button type="button" class="btn close" data-drawer="{{ id }}" aria-label="Close the {{ title }}">Close</button></div>
  {% if a.error %}
  <p class="assess-error">The assessment failed: {{ a.error }}</p>
  {% else %}
  <div class="assess-body">{{ a.html }}</div>
  {% if a.annotations %}
  <p class="ai-pointer">It marked {{ a.annotations | length | counted("problem") }} in the text: ⚠ in the text, and in the margin beside it.</p>
  <script type="application/json" id="ai-notes-data">{{ a.notes_json | tojson }}</script>
  {% endif %}
  <p class="role assess-note">{{ note }}</p>
  {% endif %}
</aside>
{% endmacro %}
{% if assessment %}{{ drawer(assessment, "assessment", "AI assessment", "Written by an AI: check it against the text.") }}{% endif %}
{% if writing %}{{ drawer(writing, "writing", "AI writing", "Written by an AI, and an indication, not a proof: careful writers show these signs too, and writers in a second language are often taken for an AI wrongly.") }}{% endif %}
<div id="review-head" aria-live="polite"><span class="which"></span><span class="where"></span><span class="spacer"></span>
  <button type="button" data-review-step="-1" title="Previous (k)">‹ Previous</button>
  <button type="button" class="next" data-review-step="1" title="Next (j)">Next ›</button></div>

{% if alt %}
<div class="split" data-split="paragraph" aria-label="Compared paragraph by paragraph">
{{ report_body(c, "paragraph", "", "sentence") }}
</div>
<div class="split" data-split="sentence" aria-label="Compared sentence by sentence" hidden>
{{ report_body(alt, "sentence", "s-", "paragraph") }}
</div>
{% else %}
{{ report_body(c, split) }}
{% endif %}

{% if assessment and assessment.save_prompt and assessment.prompt %}
<details class="prompt-sent">
  <summary><h2>Text sent to the AI</h2>
    <span class="role">its system prompt and its message, exactly as sent</span></summary>
  <pre class="prompt-text">{{ assessment.prompt_text() }}</pre>
  {% if writing and writing.prompt %}<h3>For the AI writing</h3>
  <pre class="prompt-text">{{ writing.prompt_text() }}</pre>{% endif %}
</details>
{% endif %}

<footer>Generated {{ generated }} by <a href="{{ homepage }}">prosediff</a> {{ version }}.</footer>
</main>
<div id="tip" role="tooltip" hidden></div>
<script>
(function () {
  var changes = [];
  var counter = document.querySelector(".toolbar .counter");
  var current = -1;
  var fmt = function (n) { return n.toLocaleString("en-US"); };
  // The changes of what is shown: the whole report, or, when it holds both
  // splits, the one shown.
  function refreshChanges() {
    var root = document.querySelector(".split:not([hidden])") || document;
    changes = Array.prototype.slice.call(root.querySelectorAll("tr.first-change"));
    current = -1;
    counter.textContent = fmt(changes.length);
    counter.dataset.help = fmt(changes.length) + " change" + (changes.length === 1 ? "" : "s");
    document.querySelectorAll("[data-nav]").forEach(function (b) { b.disabled = !changes.length; });
  }
  // Paragraph by paragraph, or sentence by sentence: remembered like the views.
  var splitSwitch = document.querySelector("[data-split-switch]");
  function setSplit(sentences, remember) {
    if (!splitSwitch) return;
    document.querySelectorAll(".split").forEach(function (d) {
      d.hidden = (d.dataset.split === "sentence") !== sentences;
    });
    splitSwitch.setAttribute("aria-pressed", sentences ? "true" : "false");
    splitSwitch.querySelector(".split-name").textContent = sentences ? "Sentences" : "Paragraphs";
    splitSwitch.setAttribute("aria-label", sentences
      ? "Compared sentence by sentence" : "Compared paragraph by paragraph");
    splitSwitch.dataset.help = sentences
      ? "Sentences: shown compared sentence by sentence; switch to paragraph by paragraph (s)"
      : "Paragraphs: shown compared paragraph by paragraph; switch to sentence by sentence (s)";
    if (remember) {
      try { localStorage.setItem("prosediff-split", sentences ? "sentence" : "paragraph"); } catch (e) {}
    }
    refreshChanges();
    document.dispatchEvent(new Event("prosediff-layout"));
    if (reviewing) setReview(true);  // the queue of the split shown
  }
  refreshChanges();
  if (splitSwitch) {
    var savedSplit = null;
    try { savedSplit = localStorage.getItem("prosediff-split"); } catch (e) {}
    setSplit(savedSplit === "sentence", false);
  }

  // Jump to change k (wrapping around), opening its file if collapsed.
  function go(k) {
    if (!changes.length) return;
    current = (k + changes.length) % changes.length;
    var row = changes[current];
    var file = row.closest("details");
    if (file) file.open = true;
    document.querySelectorAll("tr.current").forEach(function (r) { r.classList.remove("current"); });
    row.classList.add("current");
    row.scrollIntoView({ block: "center" });
    counter.textContent = fmt(current + 1) + " / " + fmt(changes.length);
    counter.dataset.help = "Change " + fmt(current + 1) + " of " + fmt(changes.length);
    if (shown === counter) showTip(counter);
  }

  // The views (one column, formatted, change highlights, ...) are classes
  // of the body, remembered where the browser allows.
  function setView(name, on) {
    document.body.classList.toggle(name, on);
    if (name === "formats" && on) unfoldFormats();
    var b = document.querySelector('[data-toggle="' + name + '"]');
    if (b) b.setAttribute("aria-pressed", on ? "true" : "false");
    try { localStorage.setItem("prosediff-" + name, on ? "1" : "0"); } catch (e) {}
  }
  function toggle(name) { setView(name, !document.body.classList.contains(name)); }
  // The View menu: its button opens and closes it; Escape, or a click
  // outside it, closes it. Its switches leave it open, to switch several.
  var menuButton = document.querySelector(".menu-button");
  var menuPanel = document.getElementById("view-menu");
  function setMenu(open) {
    if (!menuPanel) return;
    menuPanel.hidden = !open;
    menuButton.setAttribute("aria-expanded", open ? "true" : "false");
  }
  document.addEventListener("click", function (e) {
    if (!menuPanel) return;
    if (e.target.closest(".menu-button")) setMenu(menuPanel.hidden);
    else if (!e.target.closest(".menu-panel")) setMenu(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menuPanel && !menuPanel.hidden) {
      setMenu(false);
      menuButton.focus();
    }
  });
  // Formatted text and formatting changes are on by default, the other
  // views off; a choice the
  // browser remembers wins.
  var VIEW_DEFAULT = { unified: false, formatted: true, formats: true,
                       movelinks: false, passages: false, highlights: true, margin: true };
  Object.keys(VIEW_DEFAULT).forEach(function (name) {
    var on = VIEW_DEFAULT[name];
    try {
      var saved = localStorage.getItem("prosediff-" + name);
      if (saved !== null) on = saved === "1";
    } catch (e) {}
    document.body.classList.toggle(name, on);
    var b = document.querySelector('[data-toggle="' + name + '"]');
    if (b) b.setAttribute("aria-pressed", on ? "true" : "false");
  });
  if (document.body.classList.contains("formats")) unfoldFormats();

  // Reveal the run of unchanged lines a fold row stands for.
  function unfold(fold) {
    fold.nextElementSibling.hidden = false;
    fold.remove();
  }
  // Reveal one row of a run of unchanged lines, the rest of the run left
  // folded, before it and after it, each with its own fold.
  function foldText(fold, n) {
    var button = fold.querySelector(".expand");
    button.textContent = "⋯ ";
    var verb = document.createElement("span");
    verb.className = "verb";
    verb.textContent = "show ";
    button.appendChild(verb);
    button.appendChild(document.createTextNode(
      n.toLocaleString("en-US") + " unchanged line" + (n === 1 ? "" : "s")));
  }
  function unfoldRow(row) {
    var body = row.closest("tbody[hidden]"), fold = body && body.previousElementSibling;
    if (!fold || !fold.classList.contains("fold")) return;
    var rows = Array.prototype.slice.call(body.rows), k = rows.indexOf(row);
    var shown = document.createElement("tbody");
    body.after(shown);
    shown.appendChild(row);
    var after = rows.slice(k + 1);
    if (after.length) {
      var fold2 = fold.cloneNode(true), rest = document.createElement("tbody");
      rest.hidden = true;
      after.forEach(function (r) { rest.appendChild(r); });
      shown.after(fold2);
      fold2.after(rest);
      foldText(fold2, after.length);
    }
    if (k) foldText(fold, k);
    else { fold.remove(); body.remove(); }
  }
  // Showing the formatting changes reveals the unchanged lines that have
  // them.
  function unfoldFormats() {
    document.querySelectorAll("tbody[hidden] tr.fmt-row").forEach(function (row) {
      var body = row.closest("tbody[hidden]");
      if (body && body.previousElementSibling && body.previousElementSibling.classList.contains("fold")) {
        unfold(body.previousElementSibling);
      }
    });
  }

  document.addEventListener("click", function (e) {
    var expand = e.target.closest(".expand");
    if (expand) { unfold(expand.closest("tbody")); return; }
    var all = e.target.closest("[data-files]");
    if (all) {
      var open = all.dataset.files === "open";
      document.querySelectorAll("details.file").forEach(function (d) { d.open = open; });
      return;
    }
    var splitTo = e.target.closest("[data-split-to]");
    if (splitTo) { setSplit(splitTo.dataset.splitTo === "sentence", true); return; }
    if (e.target.closest("[data-split-switch]")) {
      setSplit(splitSwitch.getAttribute("aria-pressed") !== "true", true);
      return;
    }
    var nav = e.target.closest("[data-nav]");
    if (nav) { go(current + Number(nav.dataset.nav)); return; }
    var view = e.target.closest("[data-toggle]");
    if (view) { toggle(view.dataset.toggle); return; }
    var gap = e.target.closest("[data-gap]");
    if (gap) setGap(gapStep + Number(gap.dataset.gap));
  });

  // The space between paragraphs, in steps of a quarter line from none to
  // three lines; remembered like the views.
  var GAP_STEP = 0.25, GAP_DEFAULT = 3, GAP_MAX = 12, gapStep = GAP_DEFAULT;
  function setGap(step) {
    gapStep = Math.max(0, Math.min(GAP_MAX, step));
    document.documentElement.style.setProperty("--para-gap", gapStep * GAP_STEP + "em");
    var less = document.querySelector('[data-gap="-1"]'), more = document.querySelector('[data-gap="1"]');
    if (less) less.disabled = gapStep === 0;
    if (more) more.disabled = gapStep === GAP_MAX;
    var value = document.querySelector(".gap-value");
    if (value) {
      var lines = (gapStep * GAP_STEP).toFixed(2);
      value.textContent = lines;
      value.setAttribute("aria-valuenow", String(gapStep * GAP_STEP));
      value.setAttribute("aria-valuetext", lines + (lines === "1.00" ? " line" : " lines"));
    }
    try { localStorage.setItem("prosediff-gap", String(gapStep)); } catch (e) {}
  }
  // The value is an ARIA spinbutton: the arrow keys step it, Page Up and
  // Page Down by a line, Home and End to either end.
  var spin = document.querySelector(".gap-value");
  if (spin) spin.addEventListener("keydown", function (e) {
    var steps = { ArrowUp: 1, ArrowRight: 1, ArrowDown: -1, ArrowLeft: -1,
                  PageUp: 4, PageDown: -4 };
    if (e.key in steps) setGap(gapStep + steps[e.key]);
    else if (e.key === "Home") setGap(0);
    else if (e.key === "End") setGap(GAP_MAX);
    else return;
    e.preventDefault();
    e.stopPropagation();
  });
  try {
    var saved = localStorage.getItem("prosediff-gap");
    if (saved !== null && !isNaN(Number(saved))) setGap(Number(saved));
  } catch (e) {}

  document.addEventListener("keydown", function (e) {
    if (e.ctrlKey || e.metaKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
    var keys = { n: function () { go(current + 1); }, p: function () { go(current - 1); },
                 u: function () { toggle("unified"); }, f: function () { toggle("formatted"); },
                 m: function () { toggle("formats"); }, l: function () { toggle("movelinks"); },
                 v: function () { toggle("passages"); }, h: function () { toggle("highlights"); },
                 a: function () { goAiMark(1); }, A: function () { goAiMark(-1); },
                 c: function () { goComment(1); }, C: function () { goComment(-1); },
                 r: function () { setReview(!reviewing); },
                 g: function () { toggle("margin"); },
                 j: function () { if (reviewing) stepReview(1); },
                 k: function () { if (reviewing) stepReview(-1); },
                 s: function () { if (splitSwitch) setSplit(splitSwitch.getAttribute("aria-pressed") !== "true", true); },
