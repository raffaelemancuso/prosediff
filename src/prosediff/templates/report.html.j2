    if (!node) return "";
    var out = "", walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);
    for (var n = walker.nextNode(); n; n = walker.nextNode()) {
      if (n.parentElement.closest(NOT_TEXT) || !isShown(n.parentElement)) continue;
      out += n.data;
    }
    return out.replace(/\u00ad/g, "").replace(/\s+/g, " ").trim();
  }
  // What a row is, for the line saying where the chosen item is: a
  // paragraph, a sentence (compared sentence by sentence) or a line.
  function unitOf(row) {
    if (!row.closest("table.prose")) return "line";
    var split = row.closest(".split");
    return split && split.dataset.split === "sentence" ? "sentence" : "paragraph";
  }
  // What a change is, in a few words: its first words removed and added.
  function changeWhat(row) {
    var what = el("span");
    var first = function (sel) {
      return Array.prototype.find.call(row.querySelectorAll(sel), isShown);
    };
    var del = first("td.code.left del"), ins = first("td.code.right ins");
    if (row.classList.contains("insert") || row.classList.contains("moved-in")) {
      ins = null;
      what.appendChild(el("ins", null, textOf(row.querySelector("td.code.right"))));
    } else if (row.classList.contains("delete") || row.classList.contains("moved-out")) {
      del = null;
      what.appendChild(el("del", null, textOf(row.querySelector("td.code.left"))));
    }
    if (del) what.appendChild(el("del", null, textOf(del)));
    if (del && ins) what.appendChild(document.createTextNode(" → "));
    if (ins) what.appendChild(el("ins", null, textOf(ins)));
    // no words to show (a comment added, a space or a stop changed): the
    // paragraph's own
    if (!/\w/.test(what.textContent)) {
      what.textContent = textOf(row.querySelector("td.code.right") || row.querySelector("td.code.left"));
    }
    return what;
  }
  function buildReview() {
    reviewList.textContent = "";
    reviewItems = [];
    var root = document.querySelector(".split:not([hidden])") || document;
    function add(item, ref, what) {
      var b = el("button");
      b.type = "button";
      b.dataset.item = reviewItems.length;
      b.appendChild(el("span", "ref" + (item.kind === "problem" ? " warn" : ""), ref));
      var w = el("span", "what");
      if (typeof what === "string") w.textContent = what; else w.appendChild(what);
      b.appendChild(w);
      item.button = b;
      reviewItems.push(item);
      reviewList.appendChild(b);
      return b;
    }
    var buttons = document.querySelectorAll(".verdict-button");
    if (buttons.length) {
      reviewList.appendChild(el("h3", null, buttons.length > 1 ? "AI assessments" : "AI assessment"));
      buttons.forEach(function (b) {
        var verdict = b.querySelector(".verdict");
        add({ kind: "assessment", id: b.dataset.drawer }, "",
          b.querySelector(".role").textContent + (verdict ? ": " + verdict.textContent : ""));
      });
    }
    var rows = Array.prototype.slice.call(root.querySelectorAll("tr.first-change"));
    if (rows.length) {
      reviewList.appendChild(el("h3", null, "Changes · " + fmt(rows.length)));
      rows.forEach(function (row) { add({ kind: "change", row: row }, rowLabel(row), changeWhat(row)); });
    }
    var comments = Array.prototype.slice.call(root.querySelectorAll(".card.comment-card"));
    if (comments.length) {
      reviewList.appendChild(el("h3", null, "Comments · " + fmt(comments.length)));
      comments.forEach(function (c) {
        var row = c.closest("tr");
        add({ kind: "comment", row: row, card: c }, rowLabel(row),
          c.querySelector(".who").textContent + ": " + c.querySelector(".body").textContent);
      });
    }
    if (aiNotes.length) {
      reviewList.appendChild(el("h3", null, "Problems · " + fmt(aiNotes.length)));
      aiOrder.forEach(function (k) {
        var note = aiNotes[k], c = root.querySelector('.card[data-note="' + k + '"]');
        var b = add({ kind: "problem", row: c && c.closest("tr"), card: c },
          "⚠ " + note.num, note.problem);
        if (!c) {
          b.disabled = true;
          b.querySelector(".what").textContent = note.problem + " (not found in the text)";
        }
      });
    }
  }
  function selectReview(k) {
    var item = reviewItems[k];
    if (!item || item.button.disabled) return;
    reviewAt = k;
    reviewItems.forEach(function (it, i) {
      it.button.setAttribute("aria-current", i === k ? "true" : "false");
    });
    item.button.scrollIntoView({ block: "nearest" });
    document.querySelectorAll(".review-row").forEach(function (r) { r.classList.remove("review-row"); });
    document.querySelectorAll(".review-file").forEach(function (f) { f.classList.remove("review-file"); });
    unpin();
    var which = reviewHead.querySelector(".which"), where = reviewHead.querySelector(".where");
    if (item.kind === "assessment") {
      setDrawer(true, item.id);
      which.textContent = item.id === "writing" ? "AI writing" : "AI assessment";
      where.textContent = "";
      return;
    }
    var row = item.row, file = row.closest("details.file");
    row.classList.add("review-row");
    if (file) file.classList.add("review-file");
    reveal(row);
    if (item.card) pinMark(markOf(item.card));
    var same = reviewItems.filter(function (it) { return it.kind === item.kind; });
    which.textContent = KIND_NAMES[item.kind] + " " + fmt(same.indexOf(item) + 1) + " of " + fmt(same.length);
    var path = file && file.querySelector(":scope > summary .path");
    var files = document.querySelectorAll(".split:not([hidden]) details.file, main > details.file").length;
    where.textContent = (files > 1 && path ? path.textContent + " · " : "") +
      unitOf(row) + " " + rowLabel(row);
    window.scrollTo(0, 0);
  }
  function stepReview(step) {
    var k = reviewAt;
    for (var t = 0; t < reviewItems.length; t++) {
      k = (k + step + reviewItems.length) % reviewItems.length;
      if (!reviewItems[k].button.disabled) { selectReview(k); return; }
    }
  }
  function setReview(on) {
    reviewing = on;
    document.body.classList.toggle("review", on);
    if (reviewButton) reviewButton.setAttribute("aria-pressed", on ? "true" : "false");
    document.querySelectorAll(".review-row").forEach(function (r) { r.classList.remove("review-row"); });
    document.querySelectorAll(".review-file").forEach(function (f) { f.classList.remove("review-file"); });
    unpin();
    if (on) {
      buildReview();
      var first = reviewItems.findIndex(function (it) {
        return it.kind !== "assessment" && !it.button.disabled;
      });
      reviewAt = -1;
      if (first >= 0) selectReview(first);
    } else {
      setDrawer(false);
    }
  }
  document.addEventListener("click", function (e) {
    if (e.target.closest("[data-review]")) { setReview(!reviewing); return; }
    var item = e.target.closest("#review-list button[data-item]");
    if (item) { selectReview(Number(item.dataset.item)); return; }
    var step = e.target.closest("[data-review-step]");
    if (step) stepReview(Number(step.dataset.reviewStep));
  });

  // The tooltips: who made a tracked change and when (formatted view),
  // where a moved line went or came from (on its number) and a moved
  // passage (on it), what formatting changed, and the top bar's help. One
  // element shows them, placed by the script so no file box clips it, one
  // at a time.
  var tip = document.getElementById("tip");
  var shown = null;
  // The top bar's help, always on: its name, what it does, and its key.
  document.querySelectorAll(".toolbar [title], #review-head [title]").forEach(function (e) {
    e.dataset.help = e.title;
    e.removeAttribute("title");
  });
  function add(cls, text) {
    var e = document.createElement(cls === "b" ? "b" : "span");
    if (cls !== "b") e.className = cls;
    e.textContent = text;
    tip.appendChild(e);
  }
  function showTip(e) {
    tip.textContent = "";
    if (e.classList.contains("fmt")) {
      add("b", "Formatting changed");
      add("line", e.dataset.fmt);
    } else if (e.dataset.move) {
      add("b", e.dataset.move);
      if (e.hasAttribute("data-move-edited")) add("line", "edited on the way");
    } else if (e.matches(".s-tc-ins, .s-tc-del")) {
      add("b", e.classList.contains("s-tc-ins") ? "Tracked insertion" : "Tracked deletion");
      if (e.dataset.author) add("line", "by " + e.dataset.author);
      if (e.dataset.date) add("when", e.dataset.date);
    } else {
      // "Name: what it does (k)", or a plain text
      var m = /^(.*?)(?:: (.*?))?(?: \((.+)\))?$/.exec(e.dataset.help);
      if (m[2]) { add("b", m[1]); add("line", m[2]); } else add("line", m[1]);
      if (m[3]) add("when", "key: " + m[3]);
    }
    tip.hidden = false;
    shown = e;
    placeTip();
  }
  // Below what is hovered, or above it when there is no room below.
  function placeTip() {
    if (!shown) return;
    var r = shown.getBoundingClientRect(), t = tip.getBoundingClientRect();
    // a switch of the View menu: beside the menu, not over its other rows
    var menu = shown.closest(".menu-panel");
    if (menu) {
      var m = menu.getBoundingClientRect();
      tip.style.left = Math.max(8, m.left - t.width - 8) + "px";
      tip.style.top = Math.max(8, Math.min(r.top, window.innerHeight - t.height - 8)) + "px";
      return;
    }
    var left = Math.max(8, Math.min(anchorX || r.left, r.right - 8, window.innerWidth - t.width - 8));
    var top = r.bottom + 6 + t.height > window.innerHeight ? r.top - t.height - 6 : r.bottom + 6;
    tip.style.left = Math.max(8, left) + "px";
    tip.style.top = Math.max(8, top) + "px";
  }
  function hideTip() {
    tip.hidden = true;
    shown = null;
  }
  var anchorX = 0;
  function tipTarget(e) {
    return e.closest(".toolbar [data-help]") || e.closest("#review-head [data-help]") ||
      e.closest("td[data-move]") ||
      (document.body.classList.contains("formats") && e.closest(".fmt")) ||
      (document.body.classList.contains("formatted") && e.closest(".s-tc-ins, .s-tc-del")) ||
      e.closest(".moved[data-move]");
  }
  document.addEventListener("mouseover", function (e) {
    var t = tipTarget(e.target);
    if (t === shown) return;
    if (!t) { hideTip(); return; }
    anchorX = e.clientX;
    showTip(t);
  });
  document.addEventListener("focusin", function (e) {
    var t = tipTarget(e.target);
    if (t) { anchorX = 0; showTip(t); }
  });
  document.addEventListener("focusout", hideTip);
  // A button clicked has done what its help said: the help goes.
  document.addEventListener("click", hideTip);
  // Scrolling keeps the tooltip where it belongs.
  window.addEventListener("scroll", function () { anchorX = 0; placeTip(); }, { passive: true });

  // The lines between moved lines: drawn over each file's table, from the
  // end of a moved line's old text to the number of its new place, and
  // drawn again whenever the layout may have changed.
  var SVG = "http://www.w3.org/2000/svg";
  function drawLinks(file) {
    var old = file.querySelector(":scope > svg.move-links");
    if (old) old.remove();
    var outs = file.querySelectorAll("tr.moved-out[data-pair]");
    // moved passages only while they are shown (the "Moved passages" switch)
    var passages = document.body.classList.contains("passages")
      ? file.querySelectorAll("td.code.left .pv-on .moved[data-pair]") : [];
    if (!(outs.length || passages.length) || !file.open ||
        !document.body.classList.contains("movelinks") ||
        document.body.classList.contains("unified") || file.closest(".split[hidden]")) return;
    var box = file.getBoundingClientRect();
    var svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("class", "move-links");
    svg.setAttribute("width", box.width);
    svg.setAttribute("height", box.height);
    svg.setAttribute("aria-hidden", "true");
    outs.forEach(function (out) {
      var into = file.querySelector('tr.moved-in[data-pair="' + out.dataset.pair + '"]');
      var from = out.querySelector("td.code.left"), to = into && into.querySelector("td.no.r");
      if (!from || !to) return;
      var a = from.getBoundingClientRect(), b = to.getBoundingClientRect();
      if (!a.height || !b.height) return;
      link(svg, out.dataset.pair, a.right - box.left - 3, a.top + a.height / 2 - box.top,
        b.left - box.left + 3, b.top + b.height / 2 - box.top);
    });
    // a moved passage: from the end of its old text to the start of its new
    passages.forEach(function (out) {
      var into = file.querySelector('td.code.right .pv-on .moved[data-pair="' + out.dataset.pair + '"]');
      var from = out.getClientRects(), to = into ? into.getClientRects() : [];
      if (!from.length || !to.length) return;
      var a = from[from.length - 1], b = to[0];
      link(svg, out.dataset.pair, a.right - box.left, a.top + a.height / 2 - box.top,
        b.left - box.left, b.top + b.height / 2 - box.top);
    });
    file.appendChild(svg);
  }
  // One line, from x1 y1 to x2 y2, a dot at either end.
  function link(svg, pair, x1, y1, x2, y2) {
    // each pair bends a little further, so lines running side by side part
    var bend = Math.max(24, (x2 - x1) / 2) + (Number(pair) % 6) * 9;
    var g = document.createElementNS(SVG, "g");
    g.dataset.pair = pair;
    var path = document.createElementNS(SVG, "path");
    path.setAttribute("d", "M" + x1 + " " + y1 + " C" + (x1 + bend) + " " + y1 + " " +
      (x2 - bend) + " " + y2 + " " + x2 + " " + y2);
    g.appendChild(path);
    [[x1, y1], [x2, y2]].forEach(function (p) {
      var c = document.createElementNS(SVG, "circle");
      c.setAttribute("cx", p[0]);
      c.setAttribute("cy", p[1]);
      c.setAttribute("r", 2.5);
      g.appendChild(c);
    });
    svg.appendChild(g);
  }
  // The margin's stacks of cards, placed down each file shown, each level
  // with the top of its row: a stack taller than its row runs on down
  // beside the rows below that have no cards, and when it reaches one that
  // has, room is made after the row before it (--push), so that row's cards
  // start beside it, never after its end; the file made taller when the
  // last runs past its end. Where the cards sit under their rows (static:
  // no margin), nothing to place.
  var STACK_GAP = 8;
  function layoutNotes(file) {
    file.style.paddingBottom = "";
    var table = file.querySelector("table.notes-on");
    if (!table) return;
    Array.prototype.forEach.call(table.rows, function (r) { r.style.removeProperty("--push"); });
    if (!file.open || file.closest(".split[hidden]")) return;
    var stacks = table.querySelectorAll("td.notes > .stack");
    if (!stacks.length || getComputedStyle(stacks[0]).position !== "absolute") return;
    var rows = Array.prototype.slice.call(table.rows), below = 0;
    var topOf = function (el) {
      return el.getBoundingClientRect().top - table.getBoundingClientRect().top;
    };
    stacks.forEach(function (stack) {
      var cell = stack.parentElement, row = cell.parentElement;
      if (!cell.offsetParent) return;  // a row folded away or hidden
      var at = topOf(cell);
      if (below > at) {
        // the row shown before it, made taller by what the cards above need
        var k = rows.indexOf(row) - 1;
        while (k >= 0 && !rows[k].offsetParent) k--;
        if (k >= 0) {
          rows[k].style.setProperty("--push", Math.ceil(below - at) + "px");
          at = topOf(cell);
        }
      }
      stack.style.top = "4px";
      below = at + 4 + stack.offsetHeight + STACK_GAP;
    });
    var past = below - table.offsetHeight;
    if (past > 0) file.style.paddingBottom = past + "px";
  }
  // The columns' widths, set by dragging their handles and remembered like
  // the views: the old version's share of the two versions' width, and the
  // margin's width, in every file. None set: the table's own.
  var widths = { share: null, notes: null };
  try {
    var savedShare = parseFloat(localStorage.getItem("prosediff-old-share"));
    if (savedShare >= 0.15 && savedShare <= 0.85) widths.share = savedShare;
    var savedNotes = parseFloat(localStorage.getItem("prosediff-notes-width"));
    if (savedNotes >= 180) widths.notes = savedNotes;
  } catch (e) {}
  // The first cell of a kind that shows: those of rows folded away have no
  // size, and a table can start with a fold.
  function shownCell(table, selector) {
    var cells = table.querySelectorAll(selector);
    for (var i = 0; i < cells.length; i++) if (cells[i].offsetParent) return cells[i];
    return null;
  }
  function gutterOf(table) {
    var no = shownCell(table, "td.no");
    return no ? no.offsetWidth : 0;
  }
  function notesOf(table) {
    var cell = shownCell(table, "td.notes");
    return cell ? cell.offsetWidth : 0;
  }
  function applyWidths(table) {
    var cols = table.querySelectorAll(":scope > colgroup > col");
    if (cols.length < 4) return;
    var notes = table.querySelector("col.notes");
    if (notes) notes.style.width = widths.notes ? widths.notes + "px" : "";
    if (widths.share === null) { cols[1].style.width = ""; return; }
    var text = table.clientWidth - 2 * gutterOf(table) - notesOf(table);
    cols[1].style.width = Math.round(text * widths.share) + "px";
  }
  // The handles of a file's table, where its columns meet.
  function placeResizers(file) {
    file.querySelectorAll(":scope > .col-resizer").forEach(function (h) { h.remove(); });
    var table = file.querySelector("table");
    if (!table || !file.open || file.closest(".split[hidden]") || !table.offsetParent ||
        document.body.classList.contains("unified")) return;
    var box = file.getBoundingClientRect(), t = table.getBoundingClientRect();
    var left = shownCell(table, "td.code.left"), notes = shownCell(table, "td.notes");
    var at = [];
    if (left) at.push(["split", left.getBoundingClientRect().right]);
    if (notes) at.push(["notes", notes.getBoundingClientRect().left]);
    at.forEach(function (a) {
      var h = document.createElement("div");
      h.className = "col-resizer";
      h.dataset.resize = a[0];
      h.setAttribute("aria-hidden", "true");
      h.title = a[0] === "split"
        ? "Drag to share the width between the old and the new version; double-click for the default"
        : "Drag to widen or narrow the margin; double-click for the default";
      h.style.left = (a[1] - box.left) + "px";
      h.style.top = (t.top - box.top) + "px";
      h.style.height = t.height + "px";
      file.appendChild(h);
    });
  }
  var dragging = null;
  document.addEventListener("pointerdown", function (e) {
    var h = e.target.closest(".col-resizer");
    if (!h) return;
    e.preventDefault();
    h.setPointerCapture(e.pointerId);
    h.classList.add("dragging");
    document.body.classList.add("col-dragging");
    dragging = { handle: h, kind: h.dataset.resize, table: h.parentElement.querySelector("table") };
  });
  document.addEventListener("pointermove", function (e) {
    if (!dragging) return;
    var table = dragging.table, t = table.getBoundingClientRect();
    if (dragging.kind === "split") {
      var gutter = gutterOf(table), text = table.clientWidth - 2 * gutter - notesOf(table);
      var old = Math.min(Math.max(e.clientX - t.left - gutter, 0.15 * text), 0.85 * text);
      widths.share = old / text;
    } else {
      widths.notes = Math.round(Math.min(Math.max(t.right - e.clientX, 180), 0.5 * t.width));
    }
    document.querySelectorAll("table").forEach(applyWidths);
    dragging.handle.style.left = (e.clientX - dragging.handle.parentElement.getBoundingClientRect().left) + "px";
    drawAllLinks();
  });
  function endDrag() {
    if (!dragging) return;
    dragging.handle.classList.remove("dragging");
    document.body.classList.remove("col-dragging");
    dragging = null;
    try {
      if (widths.share !== null) localStorage.setItem("prosediff-old-share", String(widths.share));
      if (widths.notes !== null) localStorage.setItem("prosediff-notes-width", String(widths.notes));
    } catch (e) {}
    drawAllLinks();
  }
  document.addEventListener("pointerup", endDrag);
  document.addEventListener("pointercancel", endDrag);
  // Double-clicked, a handle puts its columns back as the table has them.
  document.addEventListener("dblclick", function (e) {
    var h = e.target.closest(".col-resizer");
    if (!h) return;
    var key = h.dataset.resize === "split" ? "share" : "notes";
    widths[key] = null;
    try {
      localStorage.removeItem(key === "share" ? "prosediff-old-share" : "prosediff-notes-width");
    } catch (err) {}
    document.querySelectorAll("table").forEach(applyWidths);
    drawAllLinks();
  });
  var linksPending = false;
  function drawAllLinks() {
    if (linksPending) return;
    linksPending = true;
    requestAnimationFrame(function () {
      linksPending = false;
      document.querySelectorAll("details.file").forEach(function (file) {
        var table = file.querySelector("table");
        if (table) applyWidths(table);
        layoutNotes(file);
        drawLinks(file);
        if (!dragging) placeResizers(file);  // not the one held
      });
    });
  }
  drawAllLinks();
  window.addEventListener("resize", drawAllLinks);
  document.addEventListener("prosediff-layout", drawAllLinks);
  document.addEventListener("toggle", drawAllLinks, true);
  document.addEventListener("click", function () { setTimeout(drawAllLinks, 0); });
  document.addEventListener("keydown", function () { setTimeout(drawAllLinks, 0); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawAllLinks);
  if (window.ResizeObserver) {
    var watcher = new ResizeObserver(drawAllLinks);
    document.querySelectorAll("details.file table").forEach(function (tb) { watcher.observe(tb); });
  }
  // Hovering a moved line or passage lights up the other end and the line
  // between.
  document.addEventListener("mouseover", function (e) {
    var row = e.target.closest(".moved[data-pair], tr[data-pair]");
    var hot = document.querySelectorAll(".pair-hot, svg.move-links .hot");
    hot.forEach(function (el) { el.classList.remove("pair-hot", "hot"); });
    if (!row) return;
    var file = row.closest("details.file");
    var ends = 'tr[data-pair="' + row.dataset.pair + '"], .moved[data-pair="' + row.dataset.pair + '"]';
    file.querySelectorAll(ends).forEach(function (r) {
      r.classList.add("pair-hot");
    });
    var g = file.querySelector('svg.move-links g[data-pair="' + row.dataset.pair + '"]');
    if (g) g.classList.add("hot");
  });

  // Print every file, collapsed or not.
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll("details.file").forEach(function (d) { d.open = true; });
  });
  // Copied text leaves the soft hyphens of the prose behind.
  document.addEventListener("copy", function (e) {
    var text = String(window.getSelection());
    if (text.indexOf("\u00ad") < 0 || !e.clipboardData) return;
    e.clipboardData.setData("text/plain", text.replace(/\u00ad/g, ""));
    e.preventDefault();
  });
})();
</script>
</body>
</html>
