  }
  document.addEventListener("click", function (e) {
    if (!menuPanel) return;
    if (e.target.closest(".menu-button")) setMenu(menuPanel.hidden);
    else if (!e.target.closest(".menu-panel")) setMenu(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menuPanel && !menuPanel.hidden) {
      setMenu(false);
      menuButton.focus();
    }
  });
  // Formatted text and formatting changes are on by default, the other
  // views off; a choice the
  // browser remembers wins.
  var VIEW_DEFAULT = { unified: false, formatted: true, inline: false, formats: true,
                       movelinks: true, passages: true };
  Object.keys(VIEW_DEFAULT).forEach(function (name) {
    var on = VIEW_DEFAULT[name];
    try {
      var saved = localStorage.getItem("prosediff-" + name);
      if (saved !== null) on = saved === "1";
    } catch (e) {}
    document.body.classList.toggle(name, on);
    var b = document.querySelector('[data-toggle="' + name + '"]');
    if (b) b.setAttribute("aria-pressed", on ? "true" : "false");
  });
  if (document.body.classList.contains("formats")) unfoldFormats();

  // The comments panel lists its comments in reading order ("place") or by
  // date, in either direction (descending: from the end of the report, or
  // the newest first), those without a date last; clicking the order shown
  // reverses it. Remembered like the views.
  var commentSort = { by: "place", descending: false };
  function sortComments(by, descending, remember) {
    commentSort = { by: by, descending: descending };
    var sign = descending ? -1 : 1;
    document.querySelectorAll(".comments-panel").forEach(function (panel) {
      var list = panel.querySelector("ul");
      if (!list) return;
      var items = Array.prototype.slice.call(list.children);
      items.sort(function (a, b) {
        var x = a.dataset.date, y = b.dataset.date;
        if (by === "date" && x !== y) return !x ? 1 : !y ? -1 : sign * (x < y ? -1 : 1);
        return sign * (a.dataset.place - b.dataset.place);
      });
      items.forEach(function (li) { list.appendChild(li); });
      panel.querySelectorAll("[data-sort]").forEach(function (b) {
        var on = b.dataset.sort === by;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.querySelector(".dir").textContent = on ? (descending ? "↑" : "↓") : "";
        b.setAttribute("aria-label", b.firstChild.textContent +
          (on ? (descending ? ", descending" : ", ascending") : ""));
      });
    });
    if (remember) {
      try {
        localStorage.setItem("prosediff-comments-sort", by);
        localStorage.setItem("prosediff-comments-descending", descending ? "1" : "0");
      } catch (e) {}
    }
  }
  // The comments panel shows all its comments, or only the new or the
  // removed ones; remembered like the views.
  function showComments(which, remember) {
    document.querySelectorAll(".comments-panel").forEach(function (panel) {
      panel.querySelectorAll("li[data-status]").forEach(function (li) {
        li.hidden = which !== "all" && li.dataset.status !== which;
      });
      panel.querySelectorAll("[data-show]").forEach(function (b) {
        b.setAttribute("aria-pressed", b.dataset.show === which ? "true" : "false");
      });
    });
    if (remember) {
      try { localStorage.setItem("prosediff-comments-show", which); } catch (e) {}
    }
  }
  try {
    var savedSort = localStorage.getItem("prosediff-comments-sort");
    var savedDescending = localStorage.getItem("prosediff-comments-descending") === "1";
    if (savedSort === "date" || savedDescending) {
      sortComments(savedSort === "date" ? "date" : "place", savedDescending, false);
    }
    var shownComments = localStorage.getItem("prosediff-comments-show");
    if (shownComments === "new" || shownComments === "removed") showComments(shownComments, false);
  } catch (e) {}

  // Reveal the run of unchanged lines a fold row stands for.
  function unfold(fold) {
    fold.nextElementSibling.hidden = false;
    fold.remove();
  }
  // Showing the formatting changes reveals the unchanged lines that have
  // them.
  function unfoldFormats() {
    document.querySelectorAll("tbody[hidden] tr.fmt-row").forEach(function (row) {
      var body = row.closest("tbody[hidden]");
      if (body && body.previousElementSibling && body.previousElementSibling.classList.contains("fold")) {
        unfold(body.previousElementSibling);
      }
    });
  }

  document.addEventListener("click", function (e) {
    var expand = e.target.closest(".expand");
    if (expand) { unfold(expand.closest("tbody")); return; }
    var all = e.target.closest("[data-files]");
    if (all) {
      var open = all.dataset.files === "open";
      document.querySelectorAll("details.file").forEach(function (d) { d.open = open; });
      return;
    }
    var splitTo = e.target.closest("[data-split-to]");
    if (splitTo) { setSplit(splitTo.dataset.splitTo === "sentence", true); return; }
    if (e.target.closest("[data-split-switch]")) {
      setSplit(splitSwitch.getAttribute("aria-pressed") !== "true", true);
      return;
    }
    var nav = e.target.closest("[data-nav]");
    if (nav) { go(current + Number(nav.dataset.nav)); return; }
    // a button in the comments panel's header: not a click on the header,
    // which would fold the panel
    if (e.target.closest(".comments-head .btn")) e.preventDefault();
    var sort = e.target.closest("[data-sort]");
    if (sort) {
      var by = sort.dataset.sort;
      sortComments(by, by === commentSort.by ? !commentSort.descending : false, true);
      return;
    }
    var show = e.target.closest("[data-show]");
    if (show) { showComments(show.dataset.show, true); return; }
    var view = e.target.closest("[data-toggle]");
    if (view) { toggle(view.dataset.toggle); return; }
    var gap = e.target.closest("[data-gap]");
    if (gap) setGap(gapStep + Number(gap.dataset.gap));
  });

  // The space between paragraphs, in steps of a quarter line from none to
  // three lines; remembered like the views.
  var GAP_STEP = 0.25, GAP_DEFAULT = 3, GAP_MAX = 12, gapStep = GAP_DEFAULT;
  function setGap(step) {
    gapStep = Math.max(0, Math.min(GAP_MAX, step));
    document.documentElement.style.setProperty("--para-gap", gapStep * GAP_STEP + "em");
    var less = document.querySelector('[data-gap="-1"]'), more = document.querySelector('[data-gap="1"]');
    if (less) less.disabled = gapStep === 0;
    if (more) more.disabled = gapStep === GAP_MAX;
    var value = document.querySelector(".gap-value");
    if (value) {
